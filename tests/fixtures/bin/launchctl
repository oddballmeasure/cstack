#!/usr/bin/env node
// Fake launchctl for tests. Records argv and exits.
//   FAKE_LAUNCHCTL_LOG   file to append one JSON argv array per call to
//   FAKE_LAUNCHCTL_CODE  exit code (default 0)
import { appendFileSync } from "node:fs";
const argv = process.argv.slice(2);
if (process.env.FAKE_LAUNCHCTL_LOG) appendFileSync(process.env.FAKE_LAUNCHCTL_LOG, JSON.stringify(argv) + "\n");
if (process.env.FAKE_LAUNCHCTL_CODE && process.env.FAKE_LAUNCHCTL_CODE !== "0") process.stderr.write("fake launchctl failed\n");
process.exit(Number(process.env.FAKE_LAUNCHCTL_CODE || 0));
