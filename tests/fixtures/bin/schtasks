#!/usr/bin/env node
// Fake schtasks for tests. Records argv and exits.
//   FAKE_SCHTASKS_LOG   file to append one JSON argv array per call to
//   FAKE_SCHTASKS_CODE  exit code (default 0)
import { appendFileSync } from "node:fs";
const argv = process.argv.slice(2);
if (process.env.FAKE_SCHTASKS_LOG) appendFileSync(process.env.FAKE_SCHTASKS_LOG, JSON.stringify(argv) + "\n");
if (process.env.FAKE_SCHTASKS_CODE && process.env.FAKE_SCHTASKS_CODE !== "0") process.stderr.write("fake schtasks failed\n");
process.exit(Number(process.env.FAKE_SCHTASKS_CODE || 0));
