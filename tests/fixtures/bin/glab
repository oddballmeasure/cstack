#!/usr/bin/env node
// Scenario-driven fake glab for tests. FAKE_GLAB_SCENARIO points at a JSON file:
// { "rules": [ { "match": "<regex over argv joined by spaces>", "responses": [ {"stdout": "...", "stderr": "...", "code": 0}, ... ] } ] }
// The first rule whose regex matches answers; each rule walks its responses across calls and repeats the last.
// "json" in a response is stringified into stdout. Call counts persist in FAKE_GLAB_STATE (default: <scenario>.state).
// Unmatched calls exit 1 with "fake glab: unhandled". Every call is appended to FAKE_GLAB_LOG if set.
// glab.cmd runs this file on Windows.
import { readFileSync, writeFileSync, appendFileSync, existsSync } from "node:fs";

const argv = process.argv.slice(2);
const line = argv.join(" ");
if (process.env.FAKE_GLAB_LOG) appendFileSync(process.env.FAKE_GLAB_LOG, line + "\n");
const scenarioPath = process.env.FAKE_GLAB_SCENARIO;
const scenario = scenarioPath ? JSON.parse(readFileSync(scenarioPath, "utf8")) : { rules: [] };
const statePath = process.env.FAKE_GLAB_STATE || `${scenarioPath}.state`;
const state = scenarioPath && existsSync(statePath) ? JSON.parse(readFileSync(statePath, "utf8")) : {};
for (const [i, rule] of (scenario.rules || []).entries()) {
  if (!new RegExp(rule.match, "s").test(line)) continue;
  const n = state[i] || 0;
  state[i] = n + 1;
  writeFileSync(statePath, JSON.stringify(state));
  const resp = rule.responses[Math.min(n, rule.responses.length - 1)] || {};
  process.stdout.write(resp.json !== undefined ? JSON.stringify(resp.json) + "\n" : resp.stdout || "");
  if (resp.stderr) process.stderr.write(resp.stderr);
  process.exit(resp.code ?? 0);
}
process.stderr.write(`fake glab: unhandled: ${line}\n`);
process.exit(1);
