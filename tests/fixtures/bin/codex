#!/usr/bin/env node
// Fake codex for tests.
//   `codex login status`  prints FAKE_CODEX_LOGIN (default "Logged in using ChatGPT"), exit FAKE_CODEX_LOGIN_CODE (default 0)
//   `codex exec ...`      prints the JSONL file FAKE_CODEX_EVENTS to stdout, exits FAKE_CODEX_CODE (default 0)
//   FAKE_CODEX_LOG        file to append one JSON argv array per call to
import { appendFileSync, existsSync, readFileSync } from "node:fs";
const argv = process.argv.slice(2);
if (process.env.FAKE_CODEX_LOG) appendFileSync(process.env.FAKE_CODEX_LOG, JSON.stringify(argv) + "\n");
if (argv[0] === "login" && argv[1] === "status") {
  process.stdout.write(`${process.env.FAKE_CODEX_LOGIN ?? "Logged in using ChatGPT"}\n`);
  process.exit(Number(process.env.FAKE_CODEX_LOGIN_CODE || 0));
}
const events = process.env.FAKE_CODEX_EVENTS;
if (events && existsSync(events)) process.stdout.write(readFileSync(events, "utf8"));
process.exit(Number(process.env.FAKE_CODEX_CODE || 0));
