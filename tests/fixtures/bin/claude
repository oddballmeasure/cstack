#!/usr/bin/env node
// Fake claude for tests. Records argv and exits.
//   FAKE_CLAUDE_LOG   file to append one JSON argv array per call to
//   FAKE_CLAUDE_CODE  exit code (default 0)
import { appendFileSync } from "node:fs";
const argv = process.argv.slice(2);
if (process.env.FAKE_CLAUDE_LOG) appendFileSync(process.env.FAKE_CLAUDE_LOG, JSON.stringify(argv) + "\n");
if (process.env.FAKE_CLAUDE_CODE && process.env.FAKE_CLAUDE_CODE !== "0") process.stderr.write("fake claude failed\n");
process.exit(Number(process.env.FAKE_CLAUDE_CODE || 0));
