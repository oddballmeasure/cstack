#!/usr/bin/env node
// Fake systemd-run for tests. Records argv and exits.
//   FAKE_SYSTEMD_RUN_LOG     file to append one JSON argv array per call to
//   FAKE_SYSTEMD_RUN_CODE    exit code (default 0)
//   FAKE_SYSTEMD_RUN_STDERR  text to print on stderr
import { appendFileSync } from "node:fs";
const argv = process.argv.slice(2);
if (process.env.FAKE_SYSTEMD_RUN_LOG) appendFileSync(process.env.FAKE_SYSTEMD_RUN_LOG, JSON.stringify(argv) + "\n");
if (process.env.FAKE_SYSTEMD_RUN_STDERR) process.stderr.write(process.env.FAKE_SYSTEMD_RUN_STDERR + "\n");
process.exit(Number(process.env.FAKE_SYSTEMD_RUN_CODE || 0));
