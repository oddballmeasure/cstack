#!/usr/bin/env node
// Fake ssh for the deploy gate tests. Appends argv to FAKE_SSH_LOG, then runs the remote command
// (the last argument) locally with bash, passing stdin through, so the exit code and output are real.
// ssh.cmd runs this file on Windows.
import { appendFileSync } from "node:fs";
import { spawnSync } from "node:child_process";

const argv = process.argv.slice(2);
if (process.env.FAKE_SSH_LOG) appendFileSync(process.env.FAKE_SSH_LOG, argv.join(" ") + "\n");
const r = spawnSync("bash", ["-c", argv.at(-1)], { stdio: "inherit" });
process.exit(r.status ?? 1);
