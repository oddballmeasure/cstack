{
  "name": "cstack",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "lint": "node tests/lint/lint.mjs",
    "test": "node --test 'tests/**/*.test.mjs'",
    "coverage:gates": "node --test --experimental-test-coverage --test-coverage-branches=100 --test-coverage-lines=100 --test-coverage-include='gates/check-*.mjs' --test-coverage-include='gates/run-e2e.mjs' --test-coverage-include='gates/isolate.mjs' --test-coverage-include='gates/lib/common.mjs' --test-coverage-include='gates/lib/repo.mjs' --test-coverage-include='gates/lib/docs.mjs' --test-coverage-include='gates/settle.mjs' --test-coverage-include='gates/sync-base.mjs' --test-coverage-include='gates/publish.mjs' --test-coverage-include='gates/ci-log.mjs' --test-coverage-include='gates/profile-diff.mjs' 'tests/gates/*.test.mjs'"
  }
}
