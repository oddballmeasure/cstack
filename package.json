{
  "name": "cstack",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "node tests/lint/lint.mjs",
    "test": "node --test \"tests/gates/**/*.test.mjs\" \"tests/hooks/**/*.test.mjs\" \"tests/lint/**/*.test.mjs\" \"tests/scripts/**/*.test.mjs\"",
    "coverage:gates": "node --test --experimental-test-coverage --test-coverage-branches=100 --test-coverage-lines=100 --test-coverage-include=\"gates/check-*.mjs\" --test-coverage-include=\"gates/run-e2e.mjs\" --test-coverage-include=\"gates/isolate.mjs\" --test-coverage-include=\"gates/lib/common.mjs\" --test-coverage-include=\"gates/lib/repo.mjs\" --test-coverage-include=\"gates/lib/docs.mjs\" --test-coverage-include=\"gates/settle.mjs\" --test-coverage-include=\"gates/sync-base.mjs\" --test-coverage-include=\"gates/publish.mjs\" --test-coverage-include=\"gates/ci-log.mjs\" --test-coverage-include=\"gates/profile-diff.mjs\" --test-coverage-include=\"gates/lib/forge.mjs\" --test-coverage-include=\"gates/lib/forge-gitlab.mjs\" --test-coverage-include=\"gates/lib/change-watch.mjs\" --test-coverage-include=\"gates/forge.mjs\" --test-coverage-include=\"gates/lib/workers.mjs\" --test-coverage-include=\"gates/post-merge.mjs\" --test-coverage-include=\"gates/inbox-wait.mjs\" --test-coverage-include=\"gates/worker.mjs\" --test-coverage-include=\"gates/run-settings.mjs\" --test-coverage-include=\"gates/lib/run.mjs\" --test-coverage-include=\"gates/lib/permissions.mjs\" --test-coverage-include=\"gates/scout-check.mjs\" --test-coverage-include=\"gates/scout-gate.mjs\" --test-coverage-include=\"gates/lib/scout.mjs\" --test-coverage-include=\"gates/daemon-tick.mjs\" --test-coverage-include=\"gates/deploy.mjs\" --test-coverage-include=\"gates/lib/supervisor.mjs\" --test-coverage-include=\"gates/runner.mjs\" --test-coverage-include=\"gates/supervise.mjs\" --test-coverage-include=\"gates/lib/harness.mjs\" --test-coverage-include=\"hooks/scripts/pending-work.mjs\" \"tests/gates/*.test.mjs\" \"tests/hooks/pending-work.test.mjs\""
  }
}
