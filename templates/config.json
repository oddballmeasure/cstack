{
  "version": 1,
  "repo": "owner/name",
  "base_branch": "main",
  "setup_command": null,
  "test_command": [
    "npm",
    "test"
  ],
  "e2e_command": null,
  "required_checks": [],
  "paths_off_limits": [
    ".github/workflows/**"
  ],
  "paths_hidden": [
    "tests/acceptance/**"
  ],
  "label_prefix": "cstack",
  "autonomy": "send",
  "parallel": 1,
  "models": {
    "code": "opus",
    "judge": "fable",
    "review": "sonnet",
    "gather": "haiku"
  },
  "retry_after_hours": null,
  "scout": {
    "autonomy": "propose",
    "categories": ["bug", "regression", "docs", "enhancement", "feature"],
    "areas_per_pass": 2,
    "cooldown_days": 7,
    "max_proposals_per_pass": 3,
    "max_files": 3,
    "repro": true,
    "auto_min_decided": 10,
    "auto_min_approval": 0.8,
    "auto_min_done": 0.7
  },
  "deploy": null,
  "limits": {
    "coder_attempts": 3,
    "verify_rounds": 2,
    "ci_repair_rounds": 1,
    "base_sync_rounds": 2,
    "review_rounds": 3,
    "test_timeout_seconds": 1500,
    "ci_timeout_seconds": 2400
  }
}
